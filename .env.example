# Copy to .env and fill in. Never commit .env — it is gitignored.
# On Render set these in the dashboard instead; the server prefers real env vars.

# Groq — powers AI relevance ranking. Without it the app falls back to rule order.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# SerpApi — official source search. Canonical name; SERP_API_KEY is accepted as an alias.
SERPAPI_KEY=

# Admin panel writes to data/schemes.json.
# Leave false when deployed: the hosted filesystem is ephemeral, so admin edits are
# lost on restart, and the page is unauthenticated.
# Set true for local development only.
ADMIN_ENABLED=false